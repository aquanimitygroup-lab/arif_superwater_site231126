# Copy this file to .env for local testing. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit real values.

# ---------- Required ----------
# Postgres connection string. Vercel → Storage → Create Database → Neon adds this for you.
DATABASE_URL=postgres://user:password@host/dbname

# Random text, at least 32 characters. Signs admin sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The first administrator. Created automatically the first time the site runs
# with an empty database. You can remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Production facility (optional) ----------
# Lets the facility's own software send production and stock counts. At least 24 characters.
FACILITY_API_KEY=

# Your website address, used in payment return links. Leave empty to detect automatically.
SITE_URL=

# ---------- SSLCommerz (optional) ----------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" for real payments. Leave empty to use the SSLCommerz sandbox.
SSLCOMMERZ_LIVE=

# ---------- bKash Tokenized Checkout (optional) ----------
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
# Leave empty for the bKash sandbox. For live payments, paste the live base URL bKash gives you.
BKASH_BASE_URL=
